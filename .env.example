# DemandOS root environment variables
# Copy relevant sections to apps/api/.env and apps/web/.env.local

# --- Backend ---
APP_NAME=DemandOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./demandos_dev.db
ACTIVE_CONNECTOR=mock
CORS_ORIGINS=["http://localhost:3000"]

# Runtime mode: "local" (default) or "vercel" (single Vercel project deployment).
# In vercel mode, DATABASE_URL must be a Postgres URL; SQLite is not durable.
DEMANDOS_RUNTIME_MODE=local

# Demo dataset scale: "full" (default, 50 products/5 stores/730 days)
# or "small" (10 products/2 stores/180 days — recommended for Vercel to avoid timeouts).
DEMANDOS_DEMO_SCALE=full

# Optional API key guard for write/control endpoints.
# When set, all POST/PATCH mutation endpoints require: X-DemandOS-API-Key: <value>
# Leave empty to disable the guard in local dev. Never commit a real key here.
DEMANDOS_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Leave blank/unset for single Vercel project mode (same-origin /api/* calls):
# NEXT_PUBLIC_API_BASE_URL=

# --- Postgres (docker-compose / production / Vercel+Neon) ---
# POSTGRES_USER=demandos
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=demandos
# DATABASE_URL=<postgres-connection-string>

# --- Shopify (Sprint 3 — leave blank until implemented) ---
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=

# --- WooCommerce (Sprint 4) ---
# WOOCOMMERCE_URL=
# WOOCOMMERCE_KEY=
# WOOCOMMERCE_SECRET=
