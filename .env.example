# DemandOS root environment variables
# Copy relevant sections to apps/api/.env and apps/web/.env.local

# --- Backend ---
APP_NAME=DemandOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./demandos_dev.db
ACTIVE_CONNECTOR=mock
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Postgres (docker-compose / production) ---
# POSTGRES_USER=demandos
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=demandos
# DATABASE_URL=postgresql://demandos:changeme@localhost:5432/demandos

# --- Shopify (Sprint 3 — leave blank until implemented) ---
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=

# --- WooCommerce (Sprint 4) ---
# WOOCOMMERCE_URL=
# WOOCOMMERCE_KEY=
# WOOCOMMERCE_SECRET=
