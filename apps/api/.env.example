# DemandOS API — environment variables
# Copy to .env and fill in values. Never commit .env.

APP_NAME=DemandOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database
# Development: SQLite
DATABASE_URL=sqlite:///./demandos_dev.db
# Production: Postgres
# DATABASE_URL=<postgres-connection-string>

# Connector selection: mock | csv | shopify
ACTIVE_CONNECTOR=mock

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Shopify (Sprint 3 — leave blank for mock/csv mode)
# SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...

# WooCommerce (Sprint 4)
# WOOCOMMERCE_URL=https://yourstore.com
# WOOCOMMERCE_KEY=ck_...
# WOOCOMMERCE_SECRET=cs_...

# API Key Guard (Sprint 9+)
# Leave blank to disable the guard (default — local dev mode).
# Set to a secret string to protect all write/control endpoints.
# The frontend operator enters this key in the /pipeline UI (sessionStorage only).
# DEMANDOS_API_KEY=your-secret-key-here
