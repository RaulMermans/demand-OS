# DemandOS Web Dashboard — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API base URL.
# Local development (frontend at :3000, backend at :8000):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Single Vercel project mode (frontend and /api/* on same domain):
# Leave NEXT_PUBLIC_API_BASE_URL blank or unset — the client will use same-origin
# relative paths ("/api/...") automatically.
# NEXT_PUBLIC_API_BASE_URL=

# Separate backend deployment (Render, Railway, Fly.io, etc.):
# NEXT_PUBLIC_API_BASE_URL=https://<your-backend-service-domain>

# Note: DEMANDOS_API_KEY is NOT a frontend environment variable.
# It is entered by the operator in the /pipeline page UI and stored
# only in sessionStorage — never in frontend env vars or code.
